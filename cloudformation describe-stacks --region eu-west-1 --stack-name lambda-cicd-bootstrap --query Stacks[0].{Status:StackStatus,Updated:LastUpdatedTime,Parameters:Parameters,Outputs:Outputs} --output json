{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Federated": "arn:aws:iam::455023172989:oidc-provider/token.actions.githubusercontent.com"
            },
            "Action": "sts:AssumeRoleWithWebIdentity",
            "Condition": {
                "StringEquals": {
                    "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
                },
                "StringLike": {
                    "token.actions.githubusercontent.com:sub": [
                        "repo:VanGoMu/lamda-cicd:ref:refs/tags/direct-v*",
                        "repo:VanGoMu/lamda-cicd:ref:refs/tags/api-v*",
                        "repo:VanGoMu/lamda-cicd:ref:refs/tags/alb-v*",
                        "repo:VanGoMu/lamda-cicd:ref:refs/tags/url-v*"
                    ]
                }
            }
        }
    ]
}
